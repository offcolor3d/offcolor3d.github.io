---

export interface Product{
    id: number;
    title: string;
    description: string;
    imagesUrl: string[];
    material: string;
    size: number[];
    price: number;
    category: string;
    subcategory: string;
}

interface Props {
    product: Product;
    url: string;
}

const { product, url } = Astro.props;

---

<article class="product-card">
    <a href={url} class="big-section">
        <img src={`/media/products/${product.imagesUrl[0]}`} alt={product.title} class="product-image"/>
    </a>
    <button class="add-to-cart small-section black-minimalist-button" data-product-id={product.id}>+</button>
</article>