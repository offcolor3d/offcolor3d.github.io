---
import ProductCard from "./ProductCard.astro";

import { ENDPOINTS } from "../config/api";

const {category, subcategory} = Astro.props;

let products = [];
let errorMessage = '';

try {
    const response = await fetch(`${ENDPOINTS.products.getAll}?category=${category}&subcategory=${subcategory}`);

    if(response.ok) {
        products = await response.json();
    } else {
        errorMessage = `Error fetching products: ${response.status} ${response.statusText}`;
    }
}
catch (error) {
    if (error instanceof Error) {
        errorMessage = `Network error: ${error.message}`;
    } else {
        errorMessage = 'An unknown network error occurred.';
    }
}
---

<div class="products-container">
    {errorMessage && (
        <div class="error-state">
            <p>⚠ {errorMessage}</p>
            <p>Intenta recargar la página en unos minutos.</p>
        </div>
    )}

    {!errorMessage && products.length === 0 && (
        <div class="empty-state">
            <p>Actualmente no hay artículos disponibles en {category}/{subcategory}.</p>
        </div>
    )}

    {!errorMessage && products.length > 0 && (
        <div class="products-grid">
            {products.map((prod: any) => (
                <ProductCard product={prod} url={`/products/${prod.id}`}/>
            ))}
        </div>
    )}
</div>